#Single Circular Linked List
class Node:
    def __init__(self, val): #constructor for node
        self.data=val   #value/data
        self.next=None  #address/pointer

class LinkedList:
    def __init__(self):
        self.head=None

    def append(self, new_node):
        if self.head == None:
            self.head=new_node
            new_node.next = self.head
        else:
            temp=self.head
            while(temp.next!=self.head):
                temp = temp.next
            temp.next=new_node
            new_node.next=self.head

    def insert(self, new_node,pos):
            if pos == 1:
                temp = self.head
                while(temp.next != self.head):  #find last node
                    temp = temp.next
                new_node.next = self.head 
                self.head = new_node 
                temp.next = self.head
            else:
                current = 1
                temp = self.head 
                while (current != pos-1):
                    current+=1
                    temp = temp.next
                new_node.next = temp.next
                temp.next = new_node

    def del_node(self, value):
            temp=self.head 
            prev = None     #deleting first node
            if temp.data == value: 
                while (temp.next != self.head): #find last node 
                    temp = temp.next
                self.head = self.head.next
                temp.next = self.head  
            else: 
                while(temp.data != value):      #traverse
                    prev = temp
                    temp = temp.next
                    if temp == self.head:
                        print("Value is note there in the list")
                        return
            prev.next = temp.next
            temp = None     #delete the temp node


    def print(self):
        print()
        print("List elements :")
        temp = self.head
        while True:     #temp != None
            print(temp.data, end=" ")
            temp = temp.next
            if temp == self.head:
               break 

